# Шаблон .env — скопируй в .env и заполни ключ:  cp .env.example .env
#
# Deepgram API — транскрипция кастдевов (см. scripts/transcribe.py).
# Получить ключ: https://console.deepgram.com/  →  API Keys
DEEPGRAM_API_KEY=

# Модель/язык/версия диаризации задаются флагами transcribe.py
# (--model nova-3, --language multi, --diarize-version v2) — менять тут не нужно.
