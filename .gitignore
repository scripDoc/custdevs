# === Аудио и исходники кастдевов (большие бинарники, не в git) ===
clients/*/01_audio/
clients/*/00_raw/
**/_old_whisper/

# Любые медиа-файлы где бы ни лежали (включая inbox/).
**/*.m4a
**/*.mp3
**/*.wav
**/*.ogg
**/*.opus
**/*.webm
**/*.mp4
**/*.mov
inbox/*.m4a
inbox/*.mp3

# === Клиентское — НЕ в git (untracked, остаётся ЛОКАЛЬНО) ===
# Решение 2026-06-07: вся папка clients/ и собранные лендинги deliverables/
# выведены из-под трекинга — это PII кастдевов (транскрипты, meta, брифы, КП)
# и клиентские deliverable'ы. На диске остаются (офис ими пользуется), в
# историю/remote БОЛЬШЕ НЕ ИДУТ. Правило вместо ручной бдительности:
# один `git add .` больше не утащит клиентское.
# (Существующая история ДО этого коммита их содержит — remote приватный,
#  историю не переписывали.)
clients/
deliverables/

# Сырые ответы Deepgram — дубликаты .transcript.md, большие, не нужны в git.
**/*.transcript.json

# Производные артефакты — пересобираются скриптом.
exports/*.zip

# Бинарные документы — не diff-ятся.
**/*.docx

# === Секреты ===
# Ключ Deepgram. Шаблон без ключа — в .env.example (он коммитится).
.env

# === Vercel ===
# ID проектов/орг в .vercel/ — в git не нужны.
.vercel/
**/.vercel/

# === Прочее ===
# Whisper-кэш моделей если случайно окажется в проекте.
.cache/
__pycache__/
*.pyc
node_modules/
dist/
.DS_Store
