# === Аудио и исходники кастдевов (большие бинарники, не в git) ===
clients/*/01_audio/
clients/*/00_raw/
**/_old_whisper/

# Любые медиа-файлы где бы ни лежали (включая inbox/).
**/*.m4a
**/*.mp3
**/*.wav
**/*.ogg
**/*.opus
**/*.webm
**/*.mp4
**/*.mov
inbox/*.m4a
inbox/*.mp3

# Примечание: клиентские ТЕКСТОВЫЕ артефакты (02_transcript/*.md|txt,
# meta.md, 03_structure.md, 04_package.md, 05_final.pdf) ОСТАЮТСЯ в git —
# это приватный репозиторий, доступ ограничен.

# Сырые ответы Deepgram — дубликаты .transcript.md, большие, не нужны в git.
**/*.transcript.json

# Производные артефакты — пересобираются скриптом.
exports/*.zip

# Бинарные документы — не diff-ятся.
**/*.docx

# === Секреты ===
# Ключ Deepgram. Шаблон без ключа — в .env.example (он коммитится).
.env

# === Vercel ===
# ID проектов/орг в .vercel/ — в git не нужны.
.vercel/
**/.vercel/

# === Прочее ===
# Whisper-кэш моделей если случайно окажется в проекте.
.cache/
__pycache__/
*.pyc
